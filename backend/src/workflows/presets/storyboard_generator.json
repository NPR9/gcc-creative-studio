{
  "id": "storyboard_generator",
  "name": "Storyboard Generator",
  "description": "Paste your script or describe the video in plain words. Gemini builds a storyboard in the studio's house format: a character sheet, then each scene with its voiceover, shot list and frames. Attach product or reference images to keep it on-brand. Not happy with some frames? Use Revise to change only those.",
  "category": "Briefing",
  "steps": [
    {
      "stepId": "user_input",
      "type": "user_input",
      "status": "idle",
      "inputs": {},
      "settings": {},
      "outputs": {
        "Script_or_video_idea": {
          "type": "text"
        },
        "Product_or_reference_images": {
          "type": "image"
        }
      }
    },
    {
      "stepId": "storyboard",
      "type": "generate_storyboard",
      "status": "idle",
      "inputs": {
        "brief": {
          "step": "user_input",
          "output": "Script_or_video_idea"
        },
        "reference_images": {
          "step": "user_input",
          "output": "Product_or_reference_images"
        }
      },
      "settings": {
        "reasoning_model": "gemini-3-pro-preview",
        "image_model": "gemini-3.1-flash-image-preview",
        "aspect_ratio": "16:9",
        "frame_style": "photo_previz",
        "board_type": "shot_by_shot",
        "max_frames": 24,
        "options_per_beat": 3,
        "character_sheets": true,
        "language": "English",
        "brand_guidelines": true,
        "brand_context": null
      },
      "outputs": {}
    }
  ]
}
